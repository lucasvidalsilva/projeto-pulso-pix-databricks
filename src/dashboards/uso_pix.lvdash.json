{
  "datasets": [
    {
      "name": "ds_uso_pix",
      "displayName": "Uso mensal do Pix",
      "queryLines": [
        "SELECT TO_DATE(CONCAT(CAST(ano_mes AS STRING), '01'), 'yyyyMMdd') AS mes,\n",
        "       ano_mes, natureza,\n",
        "       CASE WHEN natureza IN ('P2P', 'P2B', 'B2P', 'B2B') THEN natureza ELSE 'Outras' END AS grupo_natureza,\n",
        "       forma_iniciacao,\n",
        "       CASE WHEN forma_iniciacao IN ('DICT', 'QRDN', 'MANU', 'QRES') THEN forma_iniciacao ELSE 'Outras' END AS grupo_iniciacao,\n",
        "       regiao_pagador, regiao_recebedor, valor_total, quantidade_total\n",
        "FROM uso_pix_mensal\n"
      ]
    }
  ],
